---
import { bandStyle } from './templates.ts';
import TemplateLinks from './TemplateLinks.astro';
import type { TemplateLink } from './templates.ts';

interface Props {
  number: string;
  /** Heading HTML — carries <span class="accent">, so it is set rather than slotted. */
  title: string;
  /** Body copy. May contain <em>, hence set:html rather than interpolation. */
  description: string;
  /** Article plus template JSON(s), resolved in DenebGallery. */
  links: TemplateLink[];
  /** Caption above the JSON links, for templates that ship variants. */
  jsonLabel: string;
  /** Localised prefix for the heading permalink. */
  anchorLabel: string;
  /** Which band this section falls on. The card colour is derived as its inverse. */
  alt: boolean;
  chartFirst?: boolean;
  /** Anchor id, so a single template can be linked to and returned to. */
  id: string;
}
const {
  number,
  title,
  description,
  links,
  jsonLabel,
  anchorLabel,
  alt,
  chartFirst = false,
  id,
} = Astro.props;
---

<section class="template-section" id={id} style={bandStyle(alt)}>
  <div class="grid">
    <div class="text" style={chartFirst ? { order: 1 } : {}}>
      <p class="eyebrow" data-reveal>{number}</p>
      <h2 data-reveal data-reveal-delay="80">
        <Fragment set:html={title} />
        <a class="anchor" href={`#${id}`} aria-label={`${anchorLabel} ${number}`}>#</a>
      </h2>
      <p class="desc" data-reveal data-reveal-delay="160" set:html={description} />
      <div data-reveal data-reveal-delay="240">
        <TemplateLinks {links} {jsonLabel} />
      </div>
    </div>
    <div class="chart" style={chartFirst ? { order: 0 } : {}}>
      <slot />
    </div>
  </div>
</section>

<style>
  .template-section {
    position: relative;
    padding: clamp(90px, 14vh, 160px) clamp(24px, 5vw, 48px);
  }
  .grid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }
  .eyebrow {
    font: 600 13px/1 var(--font-sans);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 22px;
  }
  .text h2 {
    margin: 0 0 24px;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(32px, 4.6vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .text h2 :global(em),
  .text h2 :global(span.accent) {
    font-style: italic;
    color: var(--gold);
  }
  /* Hover-revealed deep link. Kept out of the flow's leading edge so it never
     shifts the heading, and focusable so it is reachable without a pointer. */
  .anchor {
    margin-left: 0.3em;
    font-family: var(--font-sans);
    font-size: 0.42em;
    font-weight: 600;
    color: var(--amber);
    text-decoration: none;
    vertical-align: 0.35em;
    opacity: 0;
    transition: opacity 0.3s var(--ease-signature);
  }
  .text h2:hover .anchor,
  .anchor:focus-visible {
    opacity: 1;
  }
  .desc {
    margin: 0;
    max-width: 460px;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.72;
    color: var(--text-muted);
  }
  .desc :global(em) {
    font-style: normal;
    color: var(--gold);
  }
</style>
