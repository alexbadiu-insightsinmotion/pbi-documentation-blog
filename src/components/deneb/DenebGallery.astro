---
import IntroSection from './IntroSection.astro';
import ClosingSection from './ClosingSection.astro';
import DenebNav from './DenebNav.astro';
import { TEMPLATES, eyebrowFor } from './templates.ts';
import { t, type Lang } from '../../i18n/dictionary';
import { denebCopy } from '../../i18n/deneb';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const dict = t(lang);
const copy = denebCopy(lang);

// Newest first. The registry is kept in ascending order because that is how the
// templates are numbered and released; display order is a presentation choice.
const ordered = [...TEMPLATES].reverse();

// Banding starts on --bg so it meets IntroSection's --bg-alt cleanly, and with an
// even number of templates it lands back on --bg-alt to meet ClosingSection's
// gradient. Both seams stay correct as long as the count stays even — an odd
// count would double up one band at whichever end.
const isAlt = (i: number) => i % 2 === 1;

// Copy is resolved here rather than inside each template, so a template component
// stays a pure visual and every string for a locale comes from one place.
const entries = ordered.map((entry, i) => {
  const c = copy.templates[entry.slug];
  if (!c) throw new Error(`Missing ${lang} Deneb copy for slug "${entry.slug}"`);
  return {
    entry,
    props: {
      alt: isAlt(i),
      chartFirst: entry.chartFirst ?? isAlt(i),
      id: entry.slug,
      number: eyebrowFor(entry.num, c.label),
      title: c.title,
      description: c.description,
      chartLabel: c.chartLabel,
      viewLabel: dict.deneb.viewTemplate,
      extras: copy.extras,
    },
    label: c.label,
  };
});
---

<DenebNav
  entries={entries.map((e) => ({ num: e.entry.num, slug: e.entry.slug, label: e.label }))}
  label={dict.deneb.navLabel}
/>

<IntroSection count={TEMPLATES.length} copy={copy.intro} />
{entries.map(({ entry, props }) => <entry.Component {...props} />)}
<ClosingSection copy={copy.closing} />

<script>
  import { initChartAnimations } from '../../scripts/chartAnimation';
  import { initCountUp } from '../../scripts/countUp';
  import { initDenebNav } from '../../scripts/denebNav';
  initChartAnimations();
  initCountUp();
  initDenebNav();
</script>
