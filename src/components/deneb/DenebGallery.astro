---
import IntroSection from './IntroSection.astro';
import ClosingSection from './ClosingSection.astro';
import DenebNav from './DenebNav.astro';
import { TEMPLATES, eyebrowFor, upstreamHref } from './templates.ts';
import type { TemplateLink } from './templates.ts';
import { t, type Lang } from '../../i18n/dictionary';
import { denebCopy } from '../../i18n/deneb';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const dict = t(lang);
const copy = denebCopy(lang);

// Newest first. The registry is kept in ascending order because that is how the
// templates are numbered and released; display order is a presentation choice.
const ordered = [...TEMPLATES].reverse();

// Banding starts on --bg so it meets IntroSection's --bg-alt cleanly. The last
// band then depends on parity: an even count ends on --bg-alt and runs straight
// into ClosingSection's gradient (whose top edge is the same #FBF7EF); an odd
// count ends on --bg and meets it as an ordinary band edge. Anchoring parity to
// the bottom instead would double up --bg-alt against the intro, so the top seam
// wins.
const isAlt = (i: number) => i % 2 === 1;

// Copy is resolved here rather than inside each template, so a template component
// stays a pure visual and every string for a locale comes from one place.
const entries = ordered.map((entry, i) => {
  const c = copy.templates[entry.slug];
  if (!c) throw new Error(`Missing ${lang} Deneb copy for slug "${entry.slug}"`);

  // A template that ships variants needs a name for each, or its links render as
  // several identical "Template JSON" rows. Same contract as the copy above: a
  // missing one is a build error, not a silent fallback.
  const variants = c.jsonLabels ?? [];
  if (entry.json.length > 1 && variants.length !== entry.json.length) {
    throw new Error(
      `Deneb template "${entry.slug}" has ${entry.json.length} template JSONs but ` +
        `${variants.length} ${lang} jsonLabels`
    );
  }

  const links: TemplateLink[] = [
    { href: upstreamHref(entry.doc), label: dict.deneb.viewTemplate, primary: true },
    ...entry.json.map((file, j) => ({
      href: upstreamHref(file),
      label: variants[j] ?? dict.deneb.templateJson,
    })),
  ];

  return {
    entry,
    props: {
      alt: isAlt(i),
      chartFirst: entry.chartFirst ?? isAlt(i),
      id: entry.slug,
      number: eyebrowFor(entry.num, c.label),
      title: c.title,
      description: c.description,
      chartLabel: c.chartLabel,
      links,
      jsonLabel: dict.deneb.templateJson,
      imageAlt: dict.deneb.thumbAlt(c.label),
      anchorLabel: dict.deneb.anchorLabel,
      extras: copy.extras,
    },
    label: c.label,
  };
});
---

<DenebNav
  entries={entries.map((e) => ({ num: e.entry.num, slug: e.entry.slug, label: e.label }))}
  label={dict.deneb.navLabel}
/>

<IntroSection count={TEMPLATES.length} copy={copy.intro} />
{entries.map(({ entry, props }) => <entry.Component {...props} />)}
<ClosingSection copy={copy.closing} />

<script>
  import { initChartAnimations } from '../../scripts/chartAnimation';
  import { initCountUp } from '../../scripts/countUp';
  import { initDenebNav } from '../../scripts/denebNav';
  initChartAnimations();
  initCountUp();
  initDenebNav();
</script>
