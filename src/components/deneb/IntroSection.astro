---
interface Props {
  /** Template count, passed from the registry so it is never hardcoded here. */
  count: number;
  /** Localised copy from src/i18n/deneb.ts. */
  copy: {
    eyebrow: string;
    headline: string;
    lede: string;
    colA: string;
    colB: string;
    statTemplates: string;
    statThemed: string;
    statDocumented: string;
  };
}
const { count, copy } = Astro.props;
---

<section class="intro">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{copy.eyebrow}</p>
    <h2 class="headline" data-reveal data-reveal-delay="80" set:html={copy.headline} />
    <p class="lede" data-reveal data-reveal-delay="120" set:html={copy.lede} />
    <div class="two-col">
      <p data-reveal data-reveal-delay="160" set:html={copy.colA} />
      <p data-reveal data-reveal-delay="240" set:html={copy.colB} />
    </div>
    <div class="stats">
      <div data-reveal>
        <div class="stat-value"><span data-countup data-target={count} data-duration="1800">0</span></div>
        <div class="stat-label">{copy.statTemplates}</div>
      </div>
      <div data-reveal data-reveal-delay="130">
        <div class="stat-value"><span data-countup data-target="100" data-suffix="%" data-duration="1800">0%</span></div>
        <div class="stat-label" set:html={copy.statThemed} />
      </div>
      <div data-reveal data-reveal-delay="260">
        <div class="stat-value check">&#10003;</div>
        <div class="stat-label" set:html={copy.statDocumented} />
      </div>
    </div>
  </div>
</section>

<style>
  .intro {
    position: relative;
    padding: clamp(100px, 15vh, 180px) clamp(24px, 5vw, 48px);
    background: var(--bg-alt);
  }
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
  }
  .eyebrow {
    font: 600 13px/1 var(--font-sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 28px;
  }
  .headline {
    margin: 0 0 clamp(32px, 4.5vh, 52px);
    max-width: 900px;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(34px, 5.4vw, 72px);
    line-height: 1.06;
    letter-spacing: -0.018em;
    color: var(--text);
  }
  .headline .accent {
    font-style: italic;
    color: var(--gold);
  }
  .lede {
    margin: 0 0 clamp(36px, 5vh, 56px);
    max-width: 840px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(22px, 2.4vw, 33px);
    line-height: 1.4;
    color: var(--text);
  }
  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  .two-col p {
    margin: 0;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.72;
    color: var(--text-body);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: clamp(24px, 3vw, 48px);
    margin-top: clamp(56px, 9vh, 104px);
    border-top: 1px solid rgba(201, 162, 39, 0.32);
    padding-top: clamp(40px, 5vh, 64px);
  }
  .stat-value {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: clamp(54px, 7vw, 92px);
    line-height: 1;
    color: var(--text);
  }
  .stat-value.check {
    font-weight: 700;
    color: var(--gold);
  }
  .stat-label {
    margin-top: 14px;
    font: 600 12px/1.5 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber);
  }
</style>
