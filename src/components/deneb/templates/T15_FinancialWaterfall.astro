---
import TemplateSection from '../TemplateSection.astro';
import type { TemplateLink } from '../templates.ts';
import ImageChartCard from '../ImageChartCard.astro';

interface Props {
  alt: boolean;
  chartFirst: boolean;
  id: string;
  number: string;
  title: string;
  description: string;
  chartLabel: string;
  /** Article plus template JSON(s), resolved in DenebGallery. */
  links: TemplateLink[];
  jsonLabel: string;
  /** Localised thumbnail alt text, built from the template label. */
  imageAlt: string;
  anchorLabel: string;
}
const { alt, chartFirst, id, number, title, description, chartLabel, links, jsonLabel, anchorLabel, imageAlt } = Astro.props;
---

<TemplateSection
  {...{ alt, chartFirst, id, number, title, description, links, jsonLabel, anchorLabel }}
>
  <ImageChartCard
    label={chartLabel}
    src="/assets/templates/tmpl-financial.png"
    alt={imageAlt}
    stagger={14}
  />
</TemplateSection>
