---
import TemplateSection from '../TemplateSection.astro';
import ImageChartCard from '../ImageChartCard.astro';
---

<TemplateSection
  number="15 — Financial waterfall"
  description="A top-down waterfall walks from gross revenue through every cost line to net profit — EBITDA, depreciation, tax — each step anchored and labeled on a bridge chart."
  githubHref="https://github.com/alexbadiu-insightsinmotion/PBI-Documentation/blob/main/Components/Deneb/215%20-%20Financial%20Waterfall%20Chart%20(Deneb%20Template).md"
  bg="var(--bg)"
>
  <Fragment slot="title">From revenue <span class="accent">to profit</span></Fragment>
  <ImageChartCard
    label="P&L bridge · revenue to net profit"
    src="/assets/templates/tmpl-financial.png"
    alt="Financial waterfall Deneb template"
    cardBg="var(--bg-alt)"
    stagger={14}
  />
</TemplateSection>
