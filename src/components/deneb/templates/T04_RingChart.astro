---
import TemplateSection from '../TemplateSection.astro';
import type { TemplateLink } from '../templates.ts';

const RINGS = [
  { color: '#C9A227', label: 'Adoption', val: '78%' },
  { color: '#B8860B', label: 'Engagement', val: '62%' },
  { color: '#A67B45', label: 'Retention', val: '45%' },
];

interface Props {
  alt: boolean;
  chartFirst: boolean;
  id: string;
  number: string;
  title: string;
  description: string;
  /** Article plus template JSON(s), resolved in DenebGallery. */
  links: TemplateLink[];
  jsonLabel: string;
  anchorLabel: string;
}
const { alt, chartFirst, id, number, title, description, links, jsonLabel, anchorLabel } = Astro.props;
---

<TemplateSection
  {...{ alt, chartFirst, id, number, title, description, links, jsonLabel, anchorLabel }}
>
  <div class="chart-card" data-anim-root data-stagger="180">
    <svg viewBox="0 0 320 320" class="ring-svg">
      <circle cx="160" cy="160" r="138" fill="none" stroke="rgba(43,33,24,0.06)" stroke-width="24" />
      <circle cx="160" cy="160" r="104" fill="none" stroke="rgba(43,33,24,0.06)" stroke-width="24" />
      <circle cx="160" cy="160" r="70" fill="none" stroke="rgba(43,33,24,0.06)" stroke-width="24" />
      <circle cx="160" cy="160" r="138" fill="none" stroke="#C9A227" stroke-width="24" stroke-linecap="round" pathLength="1" stroke-dasharray="0.78 2" stroke-dashoffset="0.78" transform="rotate(-90 160 160)" data-anim="sweep" data-dash="0.78" data-dur="1300" />
      <circle cx="160" cy="160" r="104" fill="none" stroke="#B8860B" stroke-width="24" stroke-linecap="round" pathLength="1" stroke-dasharray="0.62 2" stroke-dashoffset="0.62" transform="rotate(-90 160 160)" data-anim="sweep" data-dash="0.62" data-dur="1300" />
      <circle cx="160" cy="160" r="70" fill="none" stroke="#A67B45" stroke-width="24" stroke-linecap="round" pathLength="1" stroke-dasharray="0.45 2" stroke-dashoffset="0.45" transform="rotate(-90 160 160)" data-anim="sweep" data-dash="0.45" data-dur="1300" />
    </svg>
    <div class="legend">
      {RINGS.map((r) => (
        <div class="legend-row">
          <span class="dot" style={{ background: r.color }}></span>
          <span class="legend-label">{r.label}</span>
          <span class="legend-value">{r.val}</span>
        </div>
      ))}
    </div>
  </div>
</TemplateSection>

<style>
  .chart-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    padding: clamp(22px, 3vw, 34px);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .ring-svg {
    width: 100%;
    max-width: 300px;
    height: auto;
  }
  .legend {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 300px;
  }
  .legend-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .legend-label {
    font: 500 14px/1 var(--font-sans);
    color: var(--text-body);
    flex: 1;
  }
  .legend-value {
    font: 700 14px/1 var(--font-sans);
    color: var(--text);
  }
</style>
