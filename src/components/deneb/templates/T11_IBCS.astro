---
import TemplateSection from '../TemplateSection.astro';

const PRODS = ['Product 1', 'Product 2', 'Product 3', 'Product 4', 'Product 5', 'Product 6', 'Product 7'];
const PY = [1370, 1460, 1650, 1600, 1590, 2200, 1280];
const ACT = [1644, 1576, 1862, 1522, 1786, 1770, 1086];
const VAR_AMT = ACT.map((a, i) => a - PY[i]);
const VAR_PCT = ACT.map((a, i) => Math.round(((a - PY[i]) / PY[i]) * 100));

const N = PRODS.length;
const COL_W = 80;
const X_START = 50;
const prodX = (i: number) => X_START + i * COL_W + COL_W / 2;

const P1_H = 160;
const P1_ZERO = 80;
const P1_SCALE = 2.0;

const P2_H = 200;
const P2_ZERO = 100;
const P2_SCALE = 0.12;

const P3_H = 220;
const P3_ZERO = 190;
const P3_SCALE = 0.06;
const BAR_W = 20;

const SVG_W = X_START + N * COL_W + 20;

const LEGEND = [
  { color: '#2B2118', label: 'Current Year', shape: 'circle' },
  { color: 'rgba(43,33,24,0.28)', label: 'Previous Year', shape: 'circle-open' },
  { color: '#C9A227', label: 'Positive Variance', shape: 'circle' },
  { color: '#5C3A2E', label: 'Negative Variance', shape: 'circle' },
];

interface Props {
  alt: boolean;
  chartFirst: boolean;
  id: string;
  number: string;
  title: string;
  description: string;
  viewLabel: string;
}
const { alt, chartFirst, id, number, title, description, viewLabel } = Astro.props;
---

<TemplateSection
  {...{ alt, chartFirst, id, number, title, description, viewLabel }}
  githubHref="https://github.com/alexbadiu-insightsinmotion/PBI-Documentation/blob/main/Components/Deneb/211%20-%20IBCS-style%20Performance%20Visual%20(Deneb%20Template).md"
>
  <div class="chart-card" data-anim-root data-stagger="80">
    <div class="legend">
      {LEGEND.map((l) => (
        <div class="legend-item">
          <span class="legend-dot" style={{ background: l.shape === 'circle-open' ? 'transparent' : l.color, border: l.shape === 'circle-open' ? `2px solid ${l.color}` : 'none' }}></span>
          <span>{l.label}</span>
        </div>
      ))}
    </div>

    <div class="panel-label">Variance Percent</div>
    <svg viewBox={`0 0 ${SVG_W} ${P1_H}`} class="ibcs-svg">
      <line x1={X_START - 10} y1={P1_ZERO} x2={SVG_W} y2={P1_ZERO} stroke="rgba(43,33,24,0.18)" stroke-width="1" />
      <text x={X_START - 14} y={P1_ZERO + 4} text-anchor="end" font-size="9" fill="#8A7C68">0%</text>
      {VAR_PCT.map((v, i) => {
        const pos = v >= 0;
        const cx = prodX(i);
        const stemH = Math.abs(v) * P1_SCALE;
        const dotY = pos ? P1_ZERO - stemH : P1_ZERO + stemH;
        const color = pos ? '#C9A227' : '#5C3A2E';
        const arrowTip = pos ? dotY - 8 : dotY + 8;
        const arrowPts = pos
          ? `${cx},${arrowTip} ${cx - 5},${arrowTip + 7} ${cx + 5},${arrowTip + 7}`
          : `${cx},${arrowTip} ${cx - 5},${arrowTip - 7} ${cx + 5},${arrowTip - 7}`;
        return (
          <g>
            <line x1={cx} y1={P1_ZERO} x2={cx} y2={dotY} stroke={color} stroke-width="1.5" data-anim="grow-y" data-origin={`${cx}px ${P1_ZERO}px`} />
            <circle cx={cx} cy={dotY} r="6" fill={color} data-anim="pop" />
            <polygon points={arrowPts} fill={color} data-anim="fade" data-dur="300" />
            <text x={cx} y={pos ? dotY - 18 : dotY + 22} text-anchor="middle" font-size="10" font-weight="700" fill={color}>
              {v > 0 ? '+' : ''}{v}%
            </text>
          </g>
        );
      })}
    </svg>

    <div class="panel-label">Variance Amount</div>
    <svg viewBox={`0 0 ${SVG_W} ${P2_H}`} class="ibcs-svg">
      <line x1={X_START - 10} y1={P2_ZERO} x2={SVG_W} y2={P2_ZERO} stroke="rgba(43,33,24,0.18)" stroke-width="1" />
      <text x={X_START - 14} y={P2_ZERO + 4} text-anchor="end" font-size="9" fill="#8A7C68">0 K</text>
      {VAR_AMT.map((v, i) => {
        const pos = v >= 0;
        const cx = prodX(i);
        const bH = Math.abs(v) * P2_SCALE;
        const barY = pos ? P2_ZERO - bH : P2_ZERO;
        const color = pos ? '#C9A227' : '#5C3A2E';
        const tipY = pos ? P2_ZERO - bH : P2_ZERO + bH;
        const arrowPts = pos
          ? `${cx},${tipY - 8} ${cx - 6},${tipY + 1} ${cx + 6},${tipY + 1}`
          : `${cx},${tipY + 8} ${cx - 6},${tipY - 1} ${cx + 6},${tipY - 1}`;
        return (
          <g>
            <rect x={cx - 13} y={barY} width="26" height={bH} fill={color} data-anim="grow-y" data-origin={`center ${P2_ZERO}px`} />
            <polygon points={arrowPts} fill={color} data-anim="fade" data-dur="300" />
            <text x={cx} y={pos ? tipY - 14 : tipY + 18} text-anchor="middle" font-size="10" font-weight="700" fill={color}>
              {v > 0 ? '+' : ''}{v} K€
            </text>
          </g>
        );
      })}
    </svg>

    <div class="panel-label">Amount</div>
    <svg viewBox={`0 0 ${SVG_W} ${P3_H}`} class="ibcs-svg">
      <line x1={X_START - 10} y1={P3_ZERO} x2={SVG_W} y2={P3_ZERO} stroke="rgba(43,33,24,0.18)" stroke-width="1" />
      {[0, 500, 1000, 1500, 2000].map((v) => {
        const y = P3_ZERO - v * P3_SCALE;
        return (
          <g>
            <line x1={X_START - 10} y1={y} x2={SVG_W} y2={y} stroke="rgba(43,33,24,0.06)" stroke-width="0.6" />
            <text x={X_START - 14} y={y + 4} text-anchor="end" font-size="9" fill="#8A7C68">{v === 0 ? '0 M' : `${(v / 1000).toFixed(1)} M`}</text>
          </g>
        );
      })}
      {PRODS.map((p, i) => {
        const cx = prodX(i);
        const pyH = PY[i] * P3_SCALE;
        const acH = ACT[i] * P3_SCALE;
        return (
          <g>
            <rect x={cx - BAR_W - 2} y={P3_ZERO - pyH} width={BAR_W} height={pyH} fill="rgba(43,33,24,0.25)" data-anim="grow-y" data-origin="center bottom" />
            <rect x={cx + 2} y={P3_ZERO - acH} width={BAR_W} height={acH} fill="#2B2118" data-anim="grow-y" data-origin="center bottom" />
            <text x={cx - BAR_W / 2 - 2} y={P3_ZERO - pyH - 5} text-anchor="middle" font-size="9" fill="#8A7C68">{(PY[i] / 1000).toFixed(1)}M€</text>
            <text x={cx + BAR_W / 2 + 2} y={P3_ZERO - acH - 5} text-anchor="middle" font-size="9" fill="#2B2118" font-weight="600">{(ACT[i] / 1000).toFixed(1)}M€</text>
            <text x={cx} y={P3_ZERO + 14} text-anchor="middle" font-size="10" fill="#8A7C68">{p}</text>
          </g>
        );
      })}
    </svg>
  </div>
</TemplateSection>

<style>
  .chart-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    padding: clamp(16px, 2.5vw, 28px);
    box-shadow: var(--card-shadow);
  }
  .legend {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    font: 400 11px/1 var(--font-sans);
    color: var(--text-body);
    align-items: center;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .panel-label {
    font: 600 11px/1 var(--font-sans);
    color: var(--text-sub);
    margin-bottom: 4px;
    padding-left: 2px;
  }
  .ibcs-svg {
    width: 100%;
    height: auto;
    font-family: 'Inter', sans-serif;
    display: block;
    margin-bottom: 8px;
  }
</style>
