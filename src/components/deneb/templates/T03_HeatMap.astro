---
import TemplateSection from '../TemplateSection.astro';
import ImageChartCard from '../ImageChartCard.astro';
---

<TemplateSection
  number="03 — Heat map"
  description="Sales by hour and weekday read as a single matrix, framed by marginal bar and column charts that sum each axis — the busy hours surface on their own."
  githubHref="https://github.com/alexbadiu-insightsinmotion/PBI-Documentation/blob/main/Components/Deneb/203%20-%20Heat%20Map%20with%20Marginal%20Bar%20and%20Column%20Charts%20(Deneb%20Template).md"
  bg="var(--bg)"
>
  <Fragment slot="title">The week, <span class="accent">by the hour</span></Fragment>
  <ImageChartCard
    label="Sales · hour × weekday"
    src="/assets/templates/tmpl-heatmap.png"
    alt="Heat map Deneb template"
    cardBg="var(--bg-alt)"
    stagger={14}
  />
</TemplateSection>
