---
import TemplateSection from '../TemplateSection.astro';
import ImageChartCard from '../ImageChartCard.astro';
---

<TemplateSection
  number="14 — Correlation matrix"
  description="A symmetric correlation matrix encodes Pearson r in both color saturation and circle size — the strongest relationships emerge at a glance, without reading a single number."
  githubHref="https://github.com/alexbadiu-insightsinmotion/PBI-Documentation/blob/main/Components/Deneb/214%20-%20Correlation%20Chart%20(Deneb%20Template).md"
  bg="var(--bg-alt)"
  chartFirst
>
  <Fragment slot="title">Every pair, <span class="accent">measured</span></Fragment>
  <ImageChartCard
    label="Pearson r · all pairs"
    src="/assets/templates/tmpl-correlation.png"
    alt="Correlation matrix Deneb template"
    stagger={14}
  />
</TemplateSection>
