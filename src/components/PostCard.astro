---
import { withBase } from '../lib/url';
import { t, type Lang } from '../i18n/dictionary';

interface Props {
  slug: string;
  tag: string;
  author: string;
  cover?: string;
  index?: number;
  lang?: Lang;
}

const { slug, tag, author, cover, index = 0, lang = 'en' } = Astro.props;
const blogPrefix = lang === 'fr' ? '/fr/blog' : '/blog';
const href = withBase(`${blogPrefix}/${slug}/`);
const delay = Math.min(index, 6) * 70;
const readMore = t(lang).readMore;
---

<article class="post-card" data-reveal data-reveal-delay={delay}>
  {cover && (
    <a href={href} class="cover-link" tabindex="-1">
      <img src={cover} alt="" loading="lazy" />
    </a>
  )}
  <div class="body">
    <div class="meta">
      <span class="tag">#{tag}</span>
      <span class="author">{author}</span>
    </div>
    <a href={href} class="read-more">{readMore} &rarr;</a>
  </div>
</article>
