---
import { site } from '../site.config';
import { withBase } from '../lib/url';
import { t, type Lang } from '../i18n/dictionary';

interface Props {
  lang?: Lang;
  altHref?: string;
}
const { lang = 'en', altHref } = Astro.props;
const dict = t(lang);
const prefix = lang === 'fr' ? '/fr' : '';

const nav = [
  { href: `${prefix}/`, label: dict.nav.home },
  { href: `${prefix}/deneb/`, label: dict.nav.deneb },
  { href: `${prefix}/tmdl/`, label: dict.nav.tmdl },
  { href: `${prefix}/themes/`, label: dict.nav.themes },
  { href: `${prefix}/search/`, label: dict.nav.search },
  { href: `${prefix}/contact/`, label: dict.nav.contact },
];

const switchHref = altHref ?? (lang === 'en' ? '/fr/' : '/');
---

<header class="header">
  <a href={withBase(`${prefix}/`)} class="wordmark">
    {site.wordmark.main} <em class="wordmark-accent">{site.wordmark.accent}</em>
  </a>
  <nav class="nav">
    {nav.map((item) => (
      <a href={withBase(item.href)}>{item.label}</a>
    ))}
    <a href={withBase(switchHref)} class="lang-switch">{dict.langSwitch}</a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 70;
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* The header wraps before the nav does. Six links plus the pill cannot share a
       line with the wordmark on a phone, and letting the nav squeeze into the
       ~150px left beside it pushed the links onto four rows. Dropping the nav to
       its own full-width line first keeps it to two. */
    flex-wrap: wrap;
    gap: 12px 24px;
    padding: 20px clamp(24px, 5vw, 48px);
    background: rgba(244, 236, 221, 0.82);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--card-border);
  }
  .wordmark {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 20px;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .wordmark-accent {
    font-style: italic;
    color: var(--gold);
  }
  .nav {
    display: flex;
    align-items: center;
    /* Six links plus the language pill no longer fit on one line on a phone, and
       body { overflow-x: hidden } would clip rather than scroll the overflow.
       Wrapping to a second line is the intended trade. */
    flex-wrap: wrap;
    justify-content: flex-end;
    flex: 1 1 auto;
    gap: 10px clamp(14px, 3vw, 32px);
  }
  .nav a {
    font: 600 13px/1 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.3s var(--ease-signature);
  }
  .nav a:hover {
    color: var(--gold);
  }
  .lang-switch {
    padding: 5px 11px;
    border: 1px solid var(--card-border);
    border-radius: 999px;
    color: var(--amber) !important;
  }
</style>
