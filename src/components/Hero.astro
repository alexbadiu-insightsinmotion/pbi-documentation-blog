---
import { site } from '../site.config';
import { t, type Lang } from '../i18n/dictionary';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const dict = t(lang);
const description = lang === 'fr' ? site.descriptionFr : site.description;
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>

  <p class="eyebrow" data-reveal>{dict.hero.eyebrow}</p>

  <h1 class="headline" data-reveal data-reveal-delay="120">
    {site.wordmark.main} <span class="shimmer">{site.wordmark.accent}</span>
  </h1>

  <div class="divider" data-reveal data-reveal-delay="240"></div>

  <p class="subtitle" data-reveal data-reveal-delay="320">{description}</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: clamp(64px, 12vh, 120px) clamp(24px, 5vw, 48px) clamp(48px, 8vh, 88px);
    background: radial-gradient(140% 95% at 50% 0%, #FBF7EF 0%, #F4ECDD 52%, #EEE1CB 100%);
    overflow: hidden;
  }
  .glow {
    position: absolute;
    top: -12%;
    left: 50%;
    transform: translateX(-50%);
    width: 84vw;
    height: 84vw;
    max-width: 940px;
    max-height: 940px;
    background: radial-gradient(circle, rgba(201, 162, 39, 0.17), transparent 62%);
    pointer-events: none;
  }
  .eyebrow {
    font: 600 clamp(11px, 1.3vw, 14px)/1 var(--font-sans);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 clamp(24px, 4vh, 40px);
  }
  .headline {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: clamp(48px, 9vw, 108px);
    line-height: 0.95;
    letter-spacing: -0.022em;
    color: var(--text);
  }
  .shimmer {
    font-style: italic;
    font-weight: 700;
    background: linear-gradient(100deg, #A67B45, #C9A227 30%, #F2DB8E 50%, #C9A227 70%, #B8860B);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 6s linear infinite;
  }
  .divider {
    width: clamp(64px, 8vw, 120px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--golden), transparent);
    margin: clamp(28px, 4.5vh, 44px) 0;
  }
  .subtitle {
    max-width: 620px;
    margin: 0;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.6;
    color: var(--text-faint);
  }
</style>
