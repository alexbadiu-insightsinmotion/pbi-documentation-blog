---
// Buttondown embed-subscribe form. Handles the real double opt-in flow
// (submit -> Buttondown emails a confirm link -> confirmed subscribers get
// an email whenever Buttondown's "RSS to email" import picks up a new entry
// from /rss.xml) once `site.buttondownUsername` is set. Until then it
// renders as a clearly-marked pending state — no broken form action.
import { site } from '../site.config';

interface Props {
  compact?: boolean;
  showHeading?: boolean;
}
const { compact = false, showHeading = true } = Astro.props;

const active = Boolean(site.buttondownUsername);
const actionUrl = `https://buttondown.com/api/emails/embed-subscribe/${site.buttondownUsername}`;
---

<div class:list={['subscribe', { compact }]}>
  {showHeading && <h3>Get new posts by email</h3>}
  <p>Verify your email once, then get a message whenever a new post goes up. No spam, unsubscribe any time.</p>
  {active ? (
    <form class="form" action={actionUrl} method="post">
      <input type="email" name="email" placeholder="you@example.com" required aria-label="Email address" />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">Subscribe</button>
    </form>
  ) : (
    <p class="pending">Subscribe form is built and ready — just waiting on a Buttondown username in `site.config.ts`.</p>
  )}
</div>

<style>
  .subscribe h3 {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    margin: 0 0 8px;
  }
  .subscribe p {
    color: var(--text-faint);
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 16px;
  }
  .form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .form input[type='email'] {
    flex: 1;
    min-width: 200px;
    font: 500 14px/1 var(--font-sans);
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--card-border);
    border-radius: 999px;
    padding: 12px 18px;
  }
  .form input[type='email']:focus {
    outline: 2px solid var(--golden);
    outline-offset: 2px;
  }
  .form button {
    border: none;
    cursor: pointer;
    border-radius: 999px;
    background: linear-gradient(100deg, #A67B45, #B8860B 55%, #C9A227);
    box-shadow: 0 16px 36px -18px rgba(184, 134, 11, 0.7);
    color: #FBF7EF;
    font: 600 14px/1 var(--font-sans);
    padding: 12px 22px;
    transition: transform 0.4s var(--ease-signature);
  }
  .form button:hover {
    transform: translateY(-2px);
  }
  .pending {
    font-style: italic;
    color: var(--text-sub);
  }

  .subscribe.compact {
    background: var(--bg-alt);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    padding: clamp(28px, 4vw, 40px);
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .subscribe.compact .form {
    justify-content: center;
  }
</style>
