---
// Zero-account "subscribe": the button goes straight to this repo's GitHub
// notification settings page (no hunting for a "Watch" button anywhere).
// Choosing "All Activity" (or Custom → Discussions) there makes GitHub
// itself email you whenever scripts/announce-new-posts.mjs opens a new
// Discussion for a freshly published post — no email service, no API key,
// no account for the site owner to create.
import { site } from '../site.config';
import { t, type Lang } from '../i18n/dictionary';

interface Props {
  compact?: boolean;
  showHeading?: boolean;
  lang?: Lang;
}
const { compact = false, showHeading = true, lang = 'en' } = Astro.props;
const copy = t(lang).subscribeBlock;
---

<div class:list={['subscribe', { compact }]}>
  {showHeading && <h3>{copy.heading}</h3>}
  <p>{copy.lede}</p>
  <a class="cta" href={site.watchUrl} target="_blank" rel="noopener noreferrer">
    {copy.cta} &rarr;
  </a>
  <p class="hint">
    <Fragment set:html={copy.hint} />
    <a href={site.discussionsUrl} target="_blank" rel="noopener noreferrer">{copy.how}</a>
  </p>
</div>

<style>
  .subscribe h3 {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    margin: 0 0 8px;
  }
  .subscribe p {
    color: var(--text-faint);
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 16px;
  }
  .cta {
    display: inline-block;
    border-radius: 999px;
    background: linear-gradient(100deg, #A67B45, #B8860B 55%, #C9A227);
    box-shadow: 0 16px 36px -18px rgba(184, 134, 11, 0.7);
    color: #FBF7EF;
    font: 600 14px/1 var(--font-sans);
    padding: 12px 22px;
    text-decoration: none;
    transition: transform 0.4s var(--ease-signature);
  }
  .cta:hover {
    transform: translateY(-2px);
  }
  .hint {
    margin: 12px 0 0;
    font-size: 12px;
  }
  .hint strong {
    color: var(--text-body);
  }
  .hint a {
    color: var(--gold);
    margin-left: 6px;
  }

  .subscribe.compact {
    background: var(--bg-alt);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    padding: clamp(28px, 4vw, 40px);
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
</style>
