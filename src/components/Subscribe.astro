---
// Zero-account "subscribe": links to this repo's GitHub Discussions
// Announcements category. Watching it (native GitHub feature) makes
// GitHub itself email you whenever scripts/announce-new-posts.mjs opens a
// new discussion for a freshly published post — no email service, no API
// key, no account for the site owner to create. See scripts/announce-new-posts.mjs.
import { site } from '../site.config';

interface Props {
  compact?: boolean;
  showHeading?: boolean;
}
const { compact = false, showHeading = true } = Astro.props;
---

<div class:list={['subscribe', { compact }]}>
  {showHeading && <h3>Get new posts by email</h3>}
  <p>No newsletter service — just GitHub's own notifications, set up once:</p>
  <ol class="steps">
    <li>Open the Announcements page (button below) — sign in to GitHub if you're not already.</li>
    <li>Click the <strong>Watch</strong> button near the top of the repo.</li>
    <li>Choose <strong>All Activity</strong> (or Custom → Discussions).</li>
  </ol>
  <a class="cta" href={site.discussionsUrl} target="_blank" rel="noopener noreferrer">
    Open Announcements &rarr;
  </a>
</div>

<style>
  .subscribe h3 {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    margin: 0 0 8px;
  }
  .subscribe p {
    color: var(--text-faint);
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .steps {
    text-align: left;
    color: var(--text-faint);
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 20px;
    padding-left: 1.2em;
    display: inline-block;
  }
  .steps li {
    margin: 4px 0;
  }
  .steps strong {
    color: var(--text-body);
  }
  .cta {
    display: inline-block;
    border-radius: 999px;
    background: linear-gradient(100deg, #A67B45, #B8860B 55%, #C9A227);
    box-shadow: 0 16px 36px -18px rgba(184, 134, 11, 0.7);
    color: #FBF7EF;
    font: 600 14px/1 var(--font-sans);
    padding: 12px 22px;
    text-decoration: none;
    transition: transform 0.4s var(--ease-signature);
  }
  .cta:hover {
    transform: translateY(-2px);
  }

  .subscribe.compact {
    background: var(--bg-alt);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    padding: clamp(28px, 4vw, 40px);
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .subscribe.compact .steps {
    text-align: left;
  }
</style>
