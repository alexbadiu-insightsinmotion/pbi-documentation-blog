---
import { site } from '../site.config';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
const socialLinks = Object.entries(site.social).filter(([, url]) => url);
---

<footer class="footer">
  <div class="col">
    <h3>Contact</h3>
    {socialLinks.length === 0 && <p class="muted">Add links in src/site.config.ts</p>}
    {socialLinks.map(([label, url]) => (
      <a href={url} target="_blank" rel="noopener noreferrer">{label}</a>
    ))}
  </div>
  <div class="col">
    <h3>Site</h3>
    <a href={withBase('/')}>Home</a>
    <a href={withBase('/about/')}>About</a>
    <a href={withBase('/rss.xml')}>RSS</a>
  </div>
  <div class="col about">
    <h3>{site.title}</h3>
    <p class="muted">{site.description}</p>
    <p class="muted">&copy; {year} {site.author}</p>
  </div>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: clamp(32px, 5vw, 64px);
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(56px, 8vh, 96px) clamp(24px, 5vw, 48px) clamp(40px, 6vh, 64px);
    border-top: 1px solid var(--card-border);
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .col h3 {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 6px;
  }
  .col a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 15px;
    transition: color 0.3s var(--ease-signature);
  }
  .col a:hover {
    color: var(--gold);
  }
  .muted {
    color: var(--text-sub);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
  .about {
    max-width: 320px;
  }
</style>
