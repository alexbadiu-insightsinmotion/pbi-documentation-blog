---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

const socialLinks = Object.entries(site.social).filter(([, url]) => url);
const socialLabels: Record<string, string> = { linkedin: 'LinkedIn', x: 'X', youtube: 'YouTube' };
---

<Base title="Contact" description="Book a session or connect on social media.">
  <section class="contact">
    <p class="eyebrow" data-reveal>Contact</p>
    <h1 data-reveal data-reveal-delay="80">Let's connect</h1>
    <p class="intro" data-reveal data-reveal-delay="160">
      Want help getting started with Power BI documentation, leveling up your team,
      or figuring out how AI fits into your BI practice? Grab a time on my calendar
      or reach out on social media.
    </p>

    <div class="card" data-reveal data-reveal-delay="240">
      <h2>Book time with me</h2>
      <p>Pick a slot that works for you and let's talk through what you're working on.</p>
      <a class="cta" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Book a session &rarr;</a>
    </div>

    {socialLinks.length > 0 && (
      <div class="card" data-reveal data-reveal-delay="320">
        <h2>Connect on social</h2>
        <p>Prefer to say hi first? Send a message — I read them all.</p>
        <div class="social-links">
          {socialLinks.map(([key, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer">{socialLabels[key] ?? key}</a>
          ))}
        </div>
      </div>
    )}
  </section>
</Base>

<style>
  .contact {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(56px, 10vh, 120px) clamp(24px, 5vw, 48px) clamp(64px, 10vh, 120px);
    text-align: center;
  }
  .eyebrow {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 16px;
  }
  .contact h1 {
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 800;
    margin: 0 0 24px;
  }
  .intro {
    color: var(--text-faint);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.6;
    margin: 0 0 48px;
  }
  .card {
    background: var(--bg-alt);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    padding: clamp(28px, 4vw, 40px);
    margin-bottom: 24px;
  }
  .card h2 {
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 700;
    margin: 0 0 10px;
  }
  .card p {
    color: var(--text-faint);
    margin: 0 0 20px;
  }
  .cta {
    display: inline-block;
    border-radius: 999px;
    background: linear-gradient(100deg, #A67B45, #B8860B 55%, #C9A227);
    box-shadow: 0 20px 46px -20px rgba(184, 134, 11, 0.7);
    color: #FBF7EF;
    font: 600 14px/1 var(--font-sans);
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 14px 28px;
    transition: transform 0.4s var(--ease-signature);
  }
  .cta:hover {
    transform: translateY(-2px);
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 20px;
  }
  .social-links a {
    font: 600 14px/1 var(--font-sans);
    color: var(--gold);
    text-decoration: none;
  }
  .social-links a:hover {
    color: var(--golden);
  }
</style>
