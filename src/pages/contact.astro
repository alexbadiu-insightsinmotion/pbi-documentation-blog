---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

const socialLabels: Record<string, string> = { x: 'X', youtube: 'YouTube' };
const extraSocialLinks = Object.entries(site.social).filter(([, url]) => url);
---

<Base title="Contact" description="Connect on LinkedIn.">
  <section class="contact">
    <p class="eyebrow" data-reveal>Contact</p>
    <h1 data-reveal data-reveal-delay="80">Let's connect</h1>
    <p class="intro" data-reveal data-reveal-delay="160">
      This series is written by two people — say hi to either of us on LinkedIn.
    </p>

    <div class="card" data-reveal data-reveal-delay="240">
      <div class="people">
        <a class="cta" href={site.linkedin} target="_blank" rel="noopener noreferrer">
          {site.author} on LinkedIn &rarr;
        </a>
        <a class="cta" href={site.coAuthor.linkedin} target="_blank" rel="noopener noreferrer">
          {site.coAuthor.name} on LinkedIn &rarr;
        </a>
      </div>

      {extraSocialLinks.length > 0 && (
        <div class="social-links">
          {extraSocialLinks.map(([key, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer">{socialLabels[key] ?? key}</a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .contact {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(56px, 10vh, 120px) clamp(24px, 5vw, 48px) clamp(64px, 10vh, 120px);
    text-align: center;
  }
  .eyebrow {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 16px;
  }
  .contact h1 {
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 800;
    margin: 0 0 24px;
  }
  .intro {
    color: var(--text-faint);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.6;
    margin: 0 0 48px;
  }
  .card {
    background: var(--bg-alt);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    padding: clamp(28px, 4vw, 40px);
  }
  .people {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
  .cta {
    display: inline-block;
    border-radius: 999px;
    background: linear-gradient(100deg, #A67B45, #B8860B 55%, #C9A227);
    box-shadow: 0 20px 46px -20px rgba(184, 134, 11, 0.7);
    color: #FBF7EF;
    font: 600 14px/1 var(--font-sans);
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 14px 28px;
    transition: transform 0.4s var(--ease-signature);
  }
  .cta:hover {
    transform: translateY(-2px);
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--card-border);
  }
  .social-links a {
    font: 600 14px/1 var(--font-sans);
    color: var(--gold);
    text-decoration: none;
  }
  .social-links a:hover {
    color: var(--golden);
  }
</style>
