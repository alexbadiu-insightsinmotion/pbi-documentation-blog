---
import Base from '../layouts/Base.astro';
import DocSeries from '../components/docSeries/DocSeries.astro';
import { seriesCopy } from '../i18n/docSeries';
import { themeDocs, themeAssets } from '../components/docSeries/themes.ts';

const copy = seriesCopy('en', 'themes');
---

<Base
  title={copy.title}
  description={copy.metaDescription(themeDocs('en').length, themeAssets('en').length)}
  altHref="/fr/themes/"
>
  <DocSeries lang="en" series="themes" />
</Base>
