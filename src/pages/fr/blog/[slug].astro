---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('blogFr');
  const sorted = [...posts].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: { post, prev: sorted[index - 1] ?? null, next: sorted[index + 1] ?? null },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const formattedDate = post.data.date.toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.cover}
  lang="fr"
  altHref={`/blog/${post.data.enSlug}/`}
>
  <article class="post">
    {post.data.cover && <img class="cover" src={post.data.cover} alt="" onerror="this.style.display='none'" />}

    <header class="post-header" data-reveal>
      <p class="eyebrow">{formattedDate} &middot; {post.data.author}</p>
      <h1>{post.data.title}</h1>
      <ul class="tags">
        <li>#{post.data.tag}</li>
      </ul>
    </header>

    <div class="layout">
      {toc.length > 0 && (
        <nav class="toc" aria-label="Table des matières">
          <p class="toc-label">Sur cette page</p>
          <ul>
            {toc.map((heading) => (
              <li style={{ paddingLeft: `${(heading.depth - 2) * 14}px` }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <div class="prose-post">
        <Content />
      </div>
    </div>

    <nav class="prev-next">
      <div>
        {prev && <a href={withBase(`/fr/blog/${prev.id}/`)}>&larr; {prev.data.title}</a>}
      </div>
      <div class="next">
        {next && <a href={withBase(`/fr/blog/${next.id}/`)}>{next.data.title} &rarr;</a>}
      </div>
    </nav>

    <p class="source">
      <a href={post.data.sourceUrl} target="_blank" rel="noopener noreferrer">Voir la source (anglais) sur GitHub</a>
    </p>
  </article>
</Base>

<style>
  .post {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 48px) clamp(48px, 8vh, 96px);
  }
  .cover {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: var(--card-radius);
    border: 1px solid var(--card-border);
    box-shadow: var(--card-shadow);
    margin: clamp(32px, 5vh, 56px) 0;
  }
  .post-header {
    max-width: 760px;
    margin: 0 auto clamp(40px, 6vh, 64px);
    text-align: center;
  }
  .eyebrow {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 16px;
  }
  .post-header h1 {
    font-size: clamp(32px, 4.6vw, 56px);
    font-weight: 800;
    margin: 0;
  }
  .tags {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
  }
  .tags li {
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--bg-alt);
    border: 1px solid var(--card-border);
    border-radius: 999px;
    padding: 6px 12px;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    max-width: 760px;
    margin: 0 auto;
  }
  @media (min-width: 960px) {
    .post {
      max-width: 1000px;
    }
    .layout {
      grid-template-columns: 200px minmax(0, 1fr);
      max-width: none;
    }
  }
  .toc {
    position: sticky;
    top: 96px;
    align-self: start;
    display: none;
  }
  @media (min-width: 960px) {
    .toc {
      display: block;
    }
  }
  .toc-label {
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 12px;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-left: 1px solid var(--card-border);
  }
  .toc a {
    display: block;
    padding: 2px 0 2px 14px;
    font-size: 13px;
    color: var(--text-faint);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--gold);
  }
  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    max-width: 760px;
    margin: clamp(48px, 7vh, 80px) auto 0;
    padding-top: 32px;
    border-top: 1px solid var(--card-border);
  }
  .prev-next a {
    font: 600 14px/1.4 var(--font-sans);
    color: var(--text-muted);
    text-decoration: none;
    max-width: 46%;
  }
  .prev-next a:hover {
    color: var(--gold);
  }
  .next {
    text-align: right;
    margin-left: auto;
  }
  .source {
    max-width: 760px;
    margin: 24px auto 0;
    text-align: center;
  }
  .source a {
    font: 600 13px/1 var(--font-sans);
    color: var(--text-sub);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
