---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
---

<Base title="À propos" lang="fr" altHref="/about/">
  <section class="about">
    <p class="eyebrow" data-reveal>À propos</p>
    <h1 data-reveal data-reveal-delay="80">{site.author}</h1>
    <div class="prose-post" data-reveal data-reveal-delay="160">
      <p>
        Ce site rassemble une série d'articles sur la documentation des projets Power BI —
        documents de conception, tests automatisés, annotations PBIR, translytical task flows,
        et les outils qui permettent de garder cette documentation réellement à jour.
      </p>
      <p>
        Chaque article part du dépôt GitHub
        {' '}<a href={site.githubRepo} target="_blank" rel="noopener noreferrer">PBI-Documentation</a>{' '},
        où l'on trouve aussi des cheat sheets, des templates, et d'autres ressources qui
        accompagnent les articles.
      </p>
    </div>
  </section>
</Base>

<style>
  .about {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(56px, 10vh, 120px) clamp(24px, 5vw, 48px) clamp(64px, 10vh, 120px);
    text-align: center;
  }
  .eyebrow {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 16px;
  }
  .about h1 {
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 800;
    margin: 0 0 32px;
  }
  .about .prose-post {
    text-align: left;
  }
</style>
