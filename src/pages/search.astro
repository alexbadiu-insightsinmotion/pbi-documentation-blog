---
import Base from '../layouts/Base.astro';
---

<Base title="Search" description="Search PBI Documentation posts by title, tag, or author.">
  <section class="search-page" data-search-root>
    <p class="eyebrow" data-reveal>Search</p>
    <h1 data-reveal data-reveal-delay="80">Find a post</h1>
    <input
      class="search-input"
      type="search"
      placeholder="Search by title, tag, or author…"
      data-search-input
      data-reveal
      data-reveal-delay="160"
      autofocus
    />
    <p class="empty" data-search-empty hidden>No posts match that search.</p>
    <div class="grid" data-search-results></div>
  </section>
</Base>

<script>
  import { initSearch } from '../scripts/search';
  initSearch();
</script>

<style>
  .search-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(56px, 10vh, 120px) clamp(24px, 5vw, 48px) clamp(64px, 8vh, 96px);
    text-align: center;
  }
  .eyebrow {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 16px;
  }
  h1 {
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 800;
    margin: 0 0 32px;
  }
  .search-input {
    width: 100%;
    max-width: 480px;
    font: 500 16px/1 var(--font-sans);
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--card-border);
    border-radius: 999px;
    padding: 14px 22px;
    margin: 0 0 48px;
  }
  .search-input:focus {
    outline: 2px solid var(--golden);
    outline-offset: 2px;
  }
  .empty {
    color: var(--text-sub);
    margin: 0 0 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(24px, 3vw, 32px);
    text-align: left;
  }
</style>
